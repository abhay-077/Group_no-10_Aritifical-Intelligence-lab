cat > .gitignore <<'EOF'
# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# IDE settings
.vscode/
.idea/

# Jupyter Notebook
.ipynb_checkpoints/

# Generated output files
*.png
*.jpg
*.jpeg
*.log

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*~

# Build and distribution files
build/
dist/
*.egg-info/
EOF